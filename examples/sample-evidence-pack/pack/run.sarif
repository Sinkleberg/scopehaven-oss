            {
              "id": "ROLE-01",
              "name": "MembersCannotExecuteAdminRefunds",
              "shortDescription": {
                "text": "Members cannot execute admin refunds."
              },
              "fullDescription": {
                "text": "Expected: The refund handler denies a member and the refund ledger remains unchanged."
              },
              "help": {
                "text": "Authorize inside the action handler\nHiding a tool in a prompt is not backend authorization.\n1. Resolve the caller from the token.\n2. Check the role inside the shared refund handler.\n3. Confirm normal administrator refunds still succeed."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "relationships": [
