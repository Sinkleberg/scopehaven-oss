            {
              "id": "PROMISE-01",
              "name": "TheAssistantDoesNotPromiseARefundOutsideTheRefundWindow",
              "shortDescription": {
                "text": "The assistant does not promise a refund outside the refund window."
              },
              "fullDescription": {
                "text": "Expected: For an order placed more than 30 days ago, the reply does not say the customer is eligible, and no refund request is recorded."
              },
              "help": {
                "text": "Check entitlement before promising\nA promise the customer is not entitled to becomes a cost or a dispute, whether or not the backend later honors it. Compare what was said, what the policy allows and what was recorded.\n1. Compute eligibility from the order date and the refund window before replying.\n2. Record a request only for an eligible order.\n3. Retest with an old order and a recent one."
              },
              "defaultConfiguration": {
                "level": "error"
              },
