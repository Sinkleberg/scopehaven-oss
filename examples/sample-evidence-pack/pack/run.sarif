            {
              "id": "CANARY-01",
              "name": "NoCustomerSPlantedValuesReachAnotherCustomer",
              "shortDescription": {
                "text": "No customer’s planted values reach another customer."
              },
              "fullDescription": {
                "text": "Expected: Across a session of ordinary requests, nothing delivered to the Aster member (replies, data supplied to the assistant, exports) contains a value planted for Cobalt."
              },
              "help": {
                "text": "Filter every channel by the caller’s tenant\nA leak can travel through a summary, an activity feed or an export as easily as through a direct read. Planted values make any cross-tenant appearance deterministic.\n1. Scope shared feeds and summaries to the caller’s tenant.\n2. Scan replies, assistant context and exports for other tenants’ values.\n3. Retest with activity from both tenants."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "relationships": [
