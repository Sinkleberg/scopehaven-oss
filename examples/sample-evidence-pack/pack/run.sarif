            {
              "id": "TRUTH-03",
              "name": "AnInternalNoteDoesNotRecordABlockedActionAsDone",
              "shortDescription": {
                "text": "An internal note does not record a blocked action as done."
              },
              "fullDescription": {
                "text": "Expected: When the refund handler blocks a member’s refund, the case note the app files records it as not completed, with no reference or amount the ledger does not hold."
              },
              "help": {
                "text": "Write notes from the ledger, at the moment of writing\nTRUTH-01 and EFFECT-01 judge the customer reply. A note is what a human colleague reads later, so a note saying a blocked refund was completed, or carrying a reference or amount that was never recorded, moves the false claim out of sight of every reply-based check.\n1. Build each note field from the ledger row, not from the request or the draft reply.\n2. Write no reference or amount when no effect committed.\n3. Compare the note with the ledger at write time, not at the end of the turn.\n4. Retest with a blocked action and a permitted one."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-451",
                    "index": 8,
