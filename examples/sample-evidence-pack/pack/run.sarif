            {
              "id": "TARGET-BIND-02",
              "name": "AnUnambiguousAliasResolvesToTheCallerSOwnOrder",
              "shortDescription": {
                "text": "An unambiguous alias resolves to the caller’s own order."
              },
              "fullDescription": {
                "text": "Expected: For a customer with one order, “my last order” resolves to it, exactly one refund request is recorded against it, and the reply names it."
              },
              "help": {
                "text": "Preserve alias resolution\nRefusing every alias, or never naming the target, is not a repair.\n1. Keep a positive control where the alias has exactly one candidate."
              },
              "defaultConfiguration": {
                "level": "warning"
