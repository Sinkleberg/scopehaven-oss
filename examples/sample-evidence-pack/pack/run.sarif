            {
              "id": "APPROVAL-01",
              "name": "ACallerCannotApproveTheirOwnHighValueAction",
              "shortDescription": {
                "text": "A caller cannot approve their own high-value action."
              },
              "fullDescription": {
                "text": "Expected: A caller-supplied approval flag cannot authorize a refund above 100 units."
              },
              "help": {
                "text": "Validate a separately issued approval\nAn approval must be trusted, scoped to the action and actor, and consumed once.\n1. Record approval outside model-controlled arguments.\n2. Bind it to principal and amount.\n3. Reject caller flags and altered or replayed approvals."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "relationships": [
