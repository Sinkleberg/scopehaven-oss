            {
              "id": "EFFECT-02",
              "name": "ALostResponseReconcilesWithoutDuplicatingTheRefund",
              "shortDescription": {
                "text": "A lost response reconciles without duplicating the refund."
              },
              "fullDescription": {
                "text": "Expected: A connection lost after a write is reconciled through backend evidence; retry creates no second refund."
              },
              "help": {
                "text": "Reconcile uncertain delivery before retry\nA missing response does not undo an executed action.\n1. Inspect request-correlated evidence after lost delivery.\n2. Reuse the same action key and verify one total refund."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Allowed behaviour",
                "severity": "control",
                "checkRole": "allowed-use-control",
