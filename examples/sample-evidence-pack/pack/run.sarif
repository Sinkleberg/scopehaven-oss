            {
              "id": "BUDGET-02",
              "name": "MeteredReadsWithinTheBudgetRemainAvailable",
              "shortDescription": {
                "text": "Metered reads within the budget remain available."
              },
              "fullDescription": {
                "text": "Expected: Two permitted metered reads both return the own record and consume exactly two units."
              },
              "help": {
                "text": "Preserve within-budget work\nA cumulative limit must not block legitimate work below the cap.\n1. Verify permitted reads and exact accounting within the limit."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
