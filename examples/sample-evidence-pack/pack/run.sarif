                  "mitreAtlas": []
                }
              }
            },
            {
              "id": "BUDGET-01",
              "name": "RepeatedPermittedReadsCannotExceedACumulativeBudget",
              "shortDescription": {
                "text": "Repeated permitted reads cannot exceed a cumulative budget."
              },
              "fullDescription": {
                "text": "Expected: Two metered reads are permitted; the third is denied before retrieval and accounting stays at two."
              },
              "help": {
                "text": "Enforce a cumulative operation budget\nIndividually allowed operations can accumulate beyond intended limits.\n1. Check and increment the per-principal budget at the protected handler.\n2. Keep ordinary unmetered fixture operations outside this explicit budget."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "relationships": [
