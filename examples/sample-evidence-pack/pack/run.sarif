            {
              "id": "PROMISE-10",
              "name": "ASupportedReasonStillGetsTheRefundItIsEntitledTo",
              "shortDescription": {
                "text": "A supported reason still gets the refund it is entitled to."
              },
              "fullDescription": {
                "text": "Expected: The same stated reason on an order inside the refund window gets an eligibility promise and exactly one recorded request."
              },
              "help": {
                "text": "Preserve entitlements when the reason is supported\nRefusing every request that comes with an explanation is not a repair.\n1. Keep a positive control with the same reason on a supported order."
              },
