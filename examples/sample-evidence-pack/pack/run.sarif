                  "owaspAgentic2026": [],
                  "owaspLlm2026": [],
                  "mitreAtlas": []
                }
              }
            },
            {
              "id": "ALLOWED-02",
              "name": "AnAuthorizedRefundExecutesOnce",
              "shortDescription": {
                "text": "An authorized refund executes once."
              },
              "fullDescription": {
                "text": "Expected: An administrator can refund 20 units; retrying the same action creates no duplicate effect."
              },
              "help": {
                "text": "Preserve authorized actions and idempotency\nA secure service must still perform valid work without duplicating actions.\n1. Authorize the actor.\n2. Scope the idempotency key to the actor.\n3. Verify actual ledger changes on the first request and retry."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Allowed behaviour",
                "severity": "control",
                "checkRole": "allowed-use-control",
                "tags": [
                  "allowed-use-control"
                ],
                "standards": {
                  "owaspLlm2025": [],
                  "cwe": [],
                  "owaspAgentic2026": [],
                  "owaspLlm2026": [],
                  "mitreAtlas": []
                }
              }
            },
            {
              "id": "APPROVAL-02",
              "name": "AValidIndependentApprovalPermitsTheAction",
              "shortDescription": {
                "text": "A valid independent approval permits the action."
              },
              "fullDescription": {
                "text": "Expected: An administrator with a valid, action-bound approval can refund 250 units."
              },
              "help": {
                "text": "Preserve approved high-value actions\nApproval enforcement should reject forged approvals while allowing valid ones.\n1. Issue approval through the separate control plane.\n2. Validate principal, amount and unused state.\n3. Verify one corresponding ledger effect."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Allowed behaviour",
                "severity": "control",
                "checkRole": "allowed-use-control",
                "tags": [
                  "allowed-use-control"
                ],
                "standards": {
                  "owaspLlm2025": [],
                  "cwe": [],
                  "owaspAgentic2026": [],
                  "owaspLlm2026": [],
                  "mitreAtlas": []
                }
              }
            },
            {
              "id": "CONCURRENT-01",
              "name": "InterleavedUsersReceiveOnlyTheirOwnRecords",
              "shortDescription": {
                "text": "Interleaved users receive only their own records."
              },
              "fullDescription": {
                "text": "Expected: Alice and Bob retain request-local identity and receive their own record under a deterministic two-user barrier."
              },
              "help": {
                "text": "Keep request state local\nShared mutable context can disclose another user’s data.\n1. Keep authenticated identity and retrieved records local to each request.\n2. Retest both users at a controlled interleaving."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "relationships": [
