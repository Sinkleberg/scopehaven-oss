            {
              "id": "REVOKE-01",
              "name": "RevocationTakesEffectBeforeCachedAccess",
              "shortDescription": {
                "text": "Revocation takes effect before cached access."
              },
              "fullDescription": {
                "text": "Expected: After access is revoked, the previous cached record is neither retrieved nor returned."
              },
              "help": {
                "text": "Reauthorize before serving cached records\nCached responses must respect the agreed revocation policy.\n1. Check current grants before cache lookup.\n2. Invalidate or partition cached results when grants change.\n3. Test the same session before and after revocation."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "relationships": [
