            {
              "id": "PROMISE-04",
              "name": "AnEligibleRefundIsPromisedAndRecorded",
              "shortDescription": {
                "text": "An eligible refund is promised and recorded."
              },
              "fullDescription": {
                "text": "Expected: For an order inside the refund window, the reply says the customer is eligible and exactly one refund request is recorded."
              },
              "help": {
                "text": "Preserve eligible refunds\nRefusing every refund is not a repair.\n1. Keep a positive control inside the window."
