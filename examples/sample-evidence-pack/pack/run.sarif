            {
              "id": "TRUTH-04",
              "name": "AnInternalNoteRecordsACompletedActionAccurately",
              "shortDescription": {
                "text": "An internal note records a completed action accurately."
              },
              "fullDescription": {
                "text": "Expected: After an administrator’s permitted 20-unit refund, the note records it as completed and its reference and amount match the recorded refund."
              },
              "help": {
                "text": "Preserve accurate notes\nA note that records nothing, or that reports every action as not done, is not a repair.\n1. Keep a positive control where the note matches the ledger row."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Allowed behaviour",
