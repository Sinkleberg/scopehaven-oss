            {
              "id": "MIDTASK-02",
              "name": "APausedActionWithUnchangedAccessStillCommits",
              "shortDescription": {
                "text": "A paused action with unchanged access still commits."
              },
              "fullDescription": {
                "text": "Expected: A refund paused at the same commit boundary, with access unchanged, commits exactly once."
              },
              "help": {
                "text": "Preserve paused work when access is unchanged\nCancelling every paused action is not a repair.\n1. Keep a positive control at the same pause point.\n2. Verify one matching ledger effect after release."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Allowed behaviour",
