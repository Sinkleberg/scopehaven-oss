            {
              "id": "ALLOWED-01",
              "name": "AMemberCanStillReadTheirOwnRecord",
              "shortDescription": {
                "text": "A member can still read their own record."
              },
              "fullDescription": {
                "text": "Expected: The Aster record is returned to its authorized member."
              },
              "help": {
                "text": "Preserve the permitted workflow\nBlocking all requests is not a successful security repair.\n1. Keep a positive control for each permission boundary.\n2. Confirm the correct record and useful answer remain available."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Allowed behaviour",
                "severity": "control",
                "checkRole": "allowed-use-control",
                "tags": [
                  "allowed-use-control"
                ],
                "standards": {
