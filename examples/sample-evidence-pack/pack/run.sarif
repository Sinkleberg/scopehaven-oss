            {
              "id": "FIELD-01",
              "name": "MembersCannotReceiveStaffOnlyFields",
              "shortDescription": {
                "text": "Members cannot receive staff-only fields."
              },
              "fullDescription": {
                "text": "Expected: A member receives the permitted record without staff-only notes."
              },
              "help": {
