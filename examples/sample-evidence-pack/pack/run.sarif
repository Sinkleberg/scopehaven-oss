              "name": "APermittedActionIsReportedAsCompleted",
              "shortDescription": {
                "text": "A permitted action is reported as completed."
              },
              "fullDescription": {
                "text": "Expected: An administrator’s permitted 20-unit refund executes once, and the reply reports it as completed."
              },
              "help": {
                "text": "Preserve truthful success reports\nReporting every action as failed is not a repair.\n1. Keep a positive control where the success claim matches one ledger effect."
              },
              "defaultConfiguration": {
