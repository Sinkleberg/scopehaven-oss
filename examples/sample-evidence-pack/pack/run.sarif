            {
              "id": "MIDTASK-01",
              "name": "AccessRemovedMidTaskStopsThePendingAction",
              "shortDescription": {
                "text": "Access removed mid-task stops the pending action."
              },
              "fullDescription": {
                "text": "Expected: An administrator’s refund that was authorized and then paused before commit does not commit once their access is removed. A fresh request after removal is also denied."
              },
              "help": {
                "text": "Reauthorize at the commit boundary\nChecking access only when a request starts lets an action already in progress finish after access is removed. Tests that send one fresh request at a time never see this window.\n1. Re-check current grants immediately before committing each effect.\n2. Bind the pending action to the grants version it was authorized under and reject it if that version changed.\n3. Retest with access removed while the action is paused, plus a control where access stays unchanged."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-367",
                    "index": 6,
