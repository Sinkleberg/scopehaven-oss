# ScopeHaven Supabase + Next.js example: the SCOPEHAVEN_TARGET_* names that profile.json refers to.
# Copy this file to a private folder outside any repository, fill it in and keep it mode 0600:
#   umask 077; cp .env.example /absolute/private/supabase-next/supabase-next.env
# Load it into the shell that runs ./scopehaven check-config and ./scopehaven assess:
#   set -a; . /absolute/private/supabase-next/supabase-next.env; set +a
# The profile holds these names only; the values are read from the environment and never written anywhere.

# Access tokens of two test users in two tenants: the "access_token" of a password grant against the local
# auth server (README.md, step 2). User A is an admin of tenant A's workspace, user B a member of tenant B's.
SCOPEHAVEN_TARGET_SUPABASE_NEXT_A=
SCOPEHAVEN_TARGET_SUPABASE_NEXT_B=

# User C's access token, copied before C signed out (POST /auth/v1/logout): a revoked session, not an expired one.
SCOPEHAVEN_TARGET_SUPABASE_NEXT_REVOKED=

# The pg-snapshot observer's read-only role on the local Postgres (127.0.0.1:54322), as user:password (README.md, step 3).
SCOPEHAVEN_TARGET_SUPABASE_NEXT_DB_READ=scopehaven_read:

# `./scopehaven init --stack supabase` takes two separate files instead: ids.env with only the _A and _B lines above
# (one key per identity), and observers.env with SCOPEHAVEN_TARGET_SUPABASE_NEXT_DB_WAL=scopehaven_wal:<password>
# (a REPLICATION role for its pg-wal observer; docs/guides/supabase-next-10-minutes.md, step 4).
