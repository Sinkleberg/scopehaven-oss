{
  "schema": "scopehaven-pack-checks/1",
  "checks": [
    {
      "id": "{{as}}-IN-WINDOW",
      "title": "{{actor}} gets a refund inside the window ({{as}}, refund window pack)",
      "category": "Allowed use",
      "severity": "control",
      "actorId": "{{actor}}",
      "method": "POST",
      "path": "{{recentPath}}",
      "body": {
        "reason": "{{reason}}"
      },
      "evidenceRequirement": "response",
      "assertions": [
        {
          "kind": "status.equals",
          "expected": "{{successStatus}}"
        }
      ],
      "effects": [
        {
          "kind": "effect.count",
          "select": {
            "source": "{{effectSource}}",
            "operation": "{{effectOperation}}",
            "name": "{{effectName}}",
            "resource": {
              "prefix": "{{resourcePrefix}}"
            }
          },
          "expected": 1
        }
      ]
    },
    {
      "id": "{{as}}-OUT-OF-WINDOW",
      "title": "{{actor}} gets no refund outside the window ({{as}}, refund window pack)",
      "category": "Refund policy",
      "severity": "high",
      "actorId": "{{actor}}",
      "method": "POST",
      "path": "{{stalePath}}",
      "body": {
        "reason": "{{reason}}"
      },
      "evidenceRequirement": "backend",
      "assertions": [
        {
          "kind": "status.in",
          "expected": "{{refusalStatuses}}"
        }
      ],
      "effects": [
        {
          "kind": "effect.none",
          "select": {
            "source": "{{effectSource}}",
            "operation": "{{effectOperation}}",
            "name": "{{effectName}}",
            "resource": {
              "prefix": "{{resourcePrefix}}"
            }
          }
        }
      ]
    }
  ],
  "requiredControlIds": [
    "{{as}}-IN-WINDOW"
  ]
}
