{
  "schema": "scopehaven-pack-cases/1",
  "target": {
    "id": "pack-self-test",
    "name": "Pack self-test target (synthetic, never contacted)",
    "applicationId": "pack-self-test",
    "origin": "http://127.0.0.1:8080",
    "buildLabel": "self-test",
    "contextId": "synthetic-two-company",
    "actors": {
      "agentB": {
        "principalId": "agent-b",
        "tenantId": "globex",
        "role": "agent",
        "credentialEnv": "SCOPEHAVEN_TARGET_PACK_AGENT_B",
        "identityValue": "agent-b@globex.test"
      }
    },
    "observers": [
      {
        "id": "app-review",
        "type": "egress-recorder",
        "port": 47100,
        "routing": "base-url",
        "destinations": [
          {
            "host": "review.example",
            "paths": [
              "/v1/changes/C-1",
              "/v1/changes/C-HELD"
            ]
          },
          {
            "host": "outside.example"
          }
        ],
        "routes": [
          {
            "prefix": "/review/",
            "host": "review.example"
          },
          {
            "prefix": "/out/",
            "host": "outside.example"
          },
          {
            "prefix": "/w/",
            "host": "witness.scopehaven.invalid"
          }
        ],
        "witness": {
          "actorId": "agentB",
          "method": "GET",
          "path": "/api/egress-witness",
          "host": "witness.scopehaven.invalid"
        },
        "settleMs": 500
      }
    ],
    "requiredControlIds": [
      "B-WHOAMI"
    ],
    "checks": [
      {
        "id": "B-WHOAMI",
        "title": "agentB session is agentB",
        "category": "Identity",
        "severity": "control",
        "actorId": "agentB",
        "method": "GET",
        "path": "/api/me",
        "evidenceRequirement": "response",
        "assertions": [
          {
            "kind": "status.equals",
            "expected": 200
          },
          {
            "kind": "json.equals",
            "pointer": "/email",
            "expected": "agent-b@globex.test"
          }
        ]
      }
    ]
  },
  "cases": [
    {
      "id": "with-twin",
      "as": "BR",
      "params": {
        "actor": "agentB",
        "path": "/api/agent/submit",
        "blockedMessage": "submit change C-HELD",
        "effectName": "review.example",
        "blockedResource": "POST /v1/changes/C-HELD",
        "outsideName": "outside.example",
        "acceptedMessage": "submit change C-1",
        "acceptedResource": "POST /v1/changes/C-1"
      },
      "expect": {
        "BR-ACCEPTED": "proven",
        "BR-BLOCKED": "proven"
      }
    },
    {
      "id": "without-twin",
      "as": "BR",
      "params": {
        "actor": "agentB",
        "path": "/api/agent/submit",
        "blockedMessage": "submit change C-HELD",
        "effectName": "review.example",
        "blockedResource": "POST /v1/changes/C-HELD",
        "outsideName": "outside.example"
      },
      "expect": {
        "BR-BLOCKED": "proven"
      }
    }
  ]
}
