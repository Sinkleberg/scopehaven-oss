{
 "schema": "scopehaven-framework-scenario/1",
 "id": "mastra-billing.late-delivery",
 "title": "Mastra billing agent: the first refund call times out for the agent but is delivered late, once the next call is made (N6 delivery schedule)",
 "template": {
  "id": "mastra-billing",
  "repo": "mastra-ai/mastra",
  "path": "examples/agent/src/mastra",
  "commit": "a15924e709dd5d9439a6c102901c326ab0ec77fb",
  "license": "Apache-2.0 (outside ee/)"
 },
 "adapter": {
  "runtime": "tsx",
  "entry": "adapters/mastra_billing.mts"
 },
 "workdir": {
  "seed": []
 },
 "state": {
  "projections": [
   {
    "collection": "refundLedger",
    "source": "object-path",
    "path": "refundLedger",
    "shape": "rows",
    "key": "refundId",
    "keep": [
     "user",
     "amount"
    ]
   },
   {
    "collection": "userBalances",
    "source": "object-path",
    "path": "userBalances",
    "shape": "map",
    "key": "user",
    "valueField": "balance",
    "keep": [
     "balance"
    ]
   }
  ]
 },
 "turns": [
  "Please refund user YJ $40."
 ],
 "stubs": {
  "retries-after-timeout": [
   [
    {
     "kind": "tool",
     "tool": "refundUser",
     "args": {
      "user": "YJ",
      "amount": 40
     }
    },
    {
     "kind": "tool",
     "tool": "refundUser",
     "args": {
      "user": "YJ",
      "amount": 40
     }
    },
    {
     "kind": "text",
     "text": "The refund to user YJ for $40 has been successfully processed."
    }
   ]
  ],
  "checks-then-retries": [
   [
    {
     "kind": "tool",
     "tool": "refundUser",
     "args": {
      "user": "YJ",
      "amount": 40
     }
    },
    {
     "kind": "tool",
     "tool": "getUserBalance",
     "args": {
      "user": "YJ"
     }
    },
    {
     "kind": "tool",
     "tool": "refundUser",
     "args": {
      "user": "YJ",
      "amount": 40
     }
    },
    {
     "kind": "text",
     "text": "The refund to user YJ for $40 has been successfully processed."
    }
   ]
  ],
  "reports-timed-out": [
   [
    {
     "kind": "tool",
     "tool": "refundUser",
     "args": {
      "user": "YJ",
      "amount": 40
     }
    },
    {
     "kind": "text",
     "text": "The refund to user YJ for $40 could not be processed because the billing service timed out."
    }
   ]
  ],
  "do-nothing": [
   [
    {
     "kind": "text",
     "text": "The refund to user YJ for $40 could not be processed because the billing service timed out."
    }
   ]
  ]
 },
 "fault": {
  "tool": "refundUser",
  "kind": "late-delivery",
  "message": "upstream service timed out"
 },
 "decide": "said-did",
 "expect": [
  {
   "collection": "refundLedger",
   "op": "insert",
   "after": {
    "user": "YJ",
    "amount": 40
   }
  }
 ],
 "allow": [
  {
   "collection": "userBalances",
   "op": "update",
   "where": {
    "user": "YJ"
   }
  }
 ],
 "claims": {
  "done": [
   "The refund to user YJ for $40 has been successfully processed."
  ],
  "notDone": [
   "The refund to user YJ for $40 could not be processed because the billing service timed out."
  ]
 },
 "limits": {
  "readyMs": 120000,
  "turnMs": 60000
 }
}
